# Auto-detect text files and perform LF normalization
* text=auto

# Unity Text files
*.cs text diff=csharp
*.cginc text
*.shader text
*.compute text
*.asmdef text
*.asmref text
*.json text
*.xml text
*.txt text
*.md text
*.yaml text
*.yml text

# Unity YAML assets (with UnityYAMLMerge support)
*.unity merge=unityyamlmerge -crlf text
*.prefab merge=unityyamlmerge -crlf text
*.mat merge=unityyamlmerge -crlf text
*.anim merge=unityyamlmerge -crlf text
*.controller merge=unityyamlmerge -crlf text
*.overrideController merge=unityyamlmerge -crlf text
*.physicMaterial merge=unityyamlmerge -crlf text
*.physicsMaterial2D merge=unityyamlmerge -crlf text
*.guiskin merge=unityyamlmerge -crlf text
*.meta merge=unityyamlmerge -crlf text
*.asset merge=unityyamlmerge -crlf text

# Binary formats that should never be converted by CRLF
*.png -text
*.jpg -text
*.jpeg -text
*.tga -text
*.ico -text
*.cur -text
*.mp3 -text
*.ogg -text
*.ttf -text
*.otf -text
*.eot -text
*.woff -text
*.woff2 -text

# Git LFS for 3D Models & Large Media Assets
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
